// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - Main user entity with Clerk authentication and business data
model User {
  id          String  @id @default(uuid())
  clerkUserId String? @unique
  firstName   String
  lastName    String?
  email       String  @unique
  phoneNumber String? @unique
  role        String  @default("user") // enum: user, admin

  // Ban system - nested object
  ban_is_banned Boolean @default(false)
  ban_type      String?
  ban_reason    String?
  ban_period    Int?

  // Account status flags
  account_created            Boolean   @default(false)
  is_unregistered            Boolean   @default(false)
  unregister_requested       Boolean   @default(false)
  unregister_scheduled_at    DateTime?
  is_account_created_skipped Boolean   @default(false)
  is_onboarded               Boolean   @default(false)

  // Profile polymorphism
  profile_type String? // enum: company, consultant

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  companyProfile    CompanyProfile?
  consultantProfile ConsultantProfile?
  chatHistory       ChatHistory[]
  blogs             Blog[]

  @@map("users")
}

// Company Profile model - Extends User with company-specific information
model CompanyProfile {
  id     String @id @default(uuid())
  userId String @unique

  // Company information
  legal_company_name       String
  country_of_incorporation String
  vat_number               String?
  company_email            String
  use_signup_email         Boolean @default(false)
  description              String? @db.Text

  // Nested location object
  location_address     String?
  location_postal_code String?
  location_country     String?

  // Nested legal representative object
  legal_rep_first_name      String?
  legal_rep_last_name       String?
  legal_rep_email           String?
  legal_rep_phone_number    String?
  legal_rep_whatsapp_number String?

  // Flags
  use_signup_info  Boolean @default(false)
  use_signup_phone Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("companies")
}

// Consultant Profile model - Extends User with consultant-specific information
model ConsultantProfile {
  id     String @id @default(uuid())
  userId String @unique

  // Consultant information
  consultant_name  String
  consultant_email String
  use_signup_email Boolean @default(false)
  description      String? @db.Text

  // Nested location object
  location_address     String?
  location_postal_code String?
  location_country     String?

  // Nested personal info object
  personal_info_first_name   String?
  personal_info_last_name    String?
  personal_info_email        String?
  personal_info_phone_number String?

  // Flags
  use_signup_info  Boolean @default(false)
  use_signup_phone Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("consultants")
}

// Inquiry model - Contact form submissions from public users
model Inquiry {
  id      String @id @default(uuid())
  name    String
  email   String
  contact String
  message String @db.Text

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inquiries")
}

// ChatHistory model - Stores chat messages for users
model ChatHistory {
  id      String @id @default(uuid())
  userId  String
  message String @db.Text

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chats")
}

enum EarlyAdopterApp {
  governance
  node
}

// EarlyAdopter model - Landing page early adopter signups
model EarlyAdopter {
  id    String          @id @default(uuid())
  email String
  app   EarlyAdopterApp @default(governance)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, app])
  @@index([app])
  @@map("early_adopters")
}

// Blog model - Stores blog posts
model Blog {
  id      String  @id @default(uuid())
  title   String
  content String  @db.Text
  img_url String?
  order   Int     @default(0)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@map("blogs")
}

// =============================================================================
// Client (tenant) registry — platform database.
// Each client has its own database (nubred_{slug}) and bucket (nubred-{slug});
// project data lives there (see prisma/tenant/schema.prisma), not here.
// =============================================================================

enum TenantStatus {
  active
  inactive
}

enum ProvisioningStatus {
  provisioning
  ready
  failed
}

enum TenantUserRole {
  owner
  master_project_manager
  project_manager
  field_observer
  viewer
}

enum RestrictionAction {
  restrict
  reactivate
}

enum RestrictionReason {
  security_violation
  client_stop_paying
}

model Tenant {
  id                 String             @id @default(uuid())
  name               String
  slug               String             @unique // immutable after insert
  databaseName       String             @unique
  bucketName         String             @unique
  maxProjects        Int
  status             TenantStatus       @default(active)
  provisioningStatus ProvisioningStatus @default(provisioning)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        TenantUser[]
  modules      TenantModule[]
  restrictions TenantRestriction[]
  jobs         Job[]

  @@index([provisioningStatus, status])
  @@map("tenants")
}

model TenantUser {
  id          String         @id @default(uuid())
  tenantId    String
  email       String // stored lowercase
  role        TenantUserRole
  clerkUserId String? // linked on first login after the invite

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([clerkUserId])
  @@index([email])
  @@map("tenant_users")
}

model TenantModule {
  tenantId String
  moduleId String
  enabled  Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, moduleId])
  @@map("tenant_modules")
}

// Append-only. The latest `restrict` row is the reason currently in force.
model TenantRestriction {
  id          String             @id @default(uuid())
  tenantId    String
  action      RestrictionAction
  reason      RestrictionReason?
  actorUserId String

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("tenant_restrictions")
}

// tenantUserId is a plain column (no FK) so history survives user removal.
model TimeUsageEvent {
  id           String   @id @default(uuid())
  tenantId     String
  tenantUserId String
  seconds      Int
  recordedAt   DateTime @default(now())

  @@index([tenantId, recordedAt])
  @@index([tenantId, tenantUserId, recordedAt])
  @@map("time_usage_events")
}

model AiUsageEvent {
  id               String   @id @default(uuid())
  tenantId         String
  tenantUserId     String
  moduleId         String
  credits          Int
  promptTokens     Int?
  completionTokens Int?
  requestId        String   @unique
  recordedAt       DateTime @default(now())

  @@index([tenantId, recordedAt])
  @@index([tenantId, tenantUserId, recordedAt])
  @@map("ai_usage_events")
}

// ---------------------------------------------------------------------------
// Postgres-backed job queue (FOR UPDATE SKIP LOCKED). Lives in the platform DB;
// handlers open the tenant database named by tenantId.
// ---------------------------------------------------------------------------

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  DEAD // Exhausted retries
}

model Job {
  id          String    @id @default(uuid())
  tenantId    String
  projectId   String? // project id inside the tenant database (no FK)
  type        String // EXTRACT_TEXT | EXTRACT_SECTION | DERIVE_CHRONOLOGY | ...
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  availableAt DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?   @db.Text
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([projectId])
  @@index([tenantId])
  @@map("jobs")
}
