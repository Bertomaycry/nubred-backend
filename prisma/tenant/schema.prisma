// ---------------------------------------------------------------------------
// Project, members, farms
// ---------------------------------------------------------------------------

model Project {
  id     String        @id @default(uuid())
  name   String
  status ProjectStatus @default(DRAFT)

  // Top-level species context (from genotype extraction / VM confirm)
  speciesId               String?
  primarySpeciesBotanical String?
  primarySpeciesCommon    String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  species     Species? @relation(fields: [speciesId], references: [id], onDelete: SetNull)

  members                  ProjectMember[]
  farms                    Farm[]
  documents                Document[]
  extractionRuns           ExtractionRun[]
  extractionSteps          ExtractionStep[]
  evidenceItems            EvidenceItem[]
  fieldOverrides           FieldOverride[]
  sectionStates            SectionState[]
  sectionRecords           SectionRecord[]
  projectSectionFilters    ProjectSectionFilter[]
  fieldObserverAssignments FieldObserverAssignment[]

  @@index([status])
  @@index([createdById])
  @@map("projects")
}

model ProjectMember {
  id              String      @id @default(uuid())
  projectId       String
  userId          String? // null until invitation is accepted
  invitedEmail    String
  role            ProjectRole
  // Additive functional role: a Grower can also be a Field Observer.
  isFieldObserver Boolean     @default(false)
  state           ActorState  @default(PENDING)
  invitedById     String?
  invitedAt       DateTime    @default(now())
  acceptedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, invitedEmail])
  @@index([userId])
  @@index([projectId, role, state])
  @@map("project_members")
}

model Farm {
  id        String  @id @default(uuid())
  projectId String
  name      String
  location  String?
  notes     String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project                  Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plots                    Plot[]
  fieldObserverAssignments FieldObserverAssignment[]

  @@index([projectId])
  @@map("farms")
}

model Plot {
  id     String  @id @default(uuid())
  farmId String
  name   String
  areaHa Float?
  notes  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm                     Farm                      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  fieldObserverAssignments FieldObserverAssignment[]

  @@index([farmId])
  @@map("plots")
}

// ---------------------------------------------------------------------------
// Documents + provenance
// ---------------------------------------------------------------------------

model Document {
  id        String @id @default(uuid())
  projectId String

  originalFilename String
  mimeType         String
  sizeBytes        Int
  checksumSha256   String?

  // S3 object identity — never a public URL
  storageKey String // projects/{projectId}/documents/{id}/...
  bucket     String?

  documentType  DocumentType   @default(OTHER)
  origin        DocumentOrigin @default(UPLOAD)
  sectionKey    String? // set when origin = CHATBOT — which section this file is for
  status        DocumentStatus @default(PENDING_UPLOAD)
  failureReason String?        @db.Text

  uploadedById String?
  uploadedAt   DateTime?

  // Triage (v2 pipeline)
  detectedType            String?
  documentDate            String?
  signed                  Boolean?
  relatedContractRecordId String?
  relevantSections        Json?
  triagedAt               DateTime?
  processedAt             DateTime?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pages         DocumentPage[]
  evidenceItems EvidenceItem[]
  extractionSteps ExtractionStep[]

  @@unique([storageKey])
  @@index([projectId, status])
  @@map("documents")
}

model DocumentPage {
  id         String @id @default(uuid())
  documentId String
  pageNumber Int // 1-based
  text       String @db.Text
  charCount  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageNumber])
  @@map("document_pages")
}

model ExtractionRun {
  id           String              @id @default(uuid())
  projectId    String
  status       ExtractionRunStatus @default(QUEUED)
  scope        String              @default("full") // full | section:<key>
  documentIds  Json?
  currentDocumentId String?
  currentSectionKey String?
  stepsDone    Int                 @default(0)
  stepsTotal   Int                 @default(0)
  promptHash   String?
  modelId      String?
  provider     String?
  inputTokens  Int?
  outputTokens Int?
  startedAt    DateTime?
  completedAt  DateTime?
  error        String?             @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps   ExtractionStep[]

  @@index([projectId, createdAt])
  @@map("extraction_runs")
}

model ExtractionStep {
  id                String               @id @default(uuid())
  extractionRunId   String
  projectId         String
  documentId        String?
  sectionKey        String
  partIndex         Int                  @default(0)
  status            ExtractionStepStatus @default(QUEUED)
  skipReason        String?
  masterFilterIds   Json?
  masterHash        String?
  userFilterVersion Int?
  modelId           String?
  inputTokens       Int?
  outputTokens      Int?
  durationMs        Int?
  error             String?              @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  extractionRun ExtractionRun    @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document      Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)
  candidates    FieldCandidate[]

  @@index([extractionRunId, sectionKey])
  @@index([projectId, documentId])
  @@map("extraction_steps")
}

model EvidenceItem {
  id           String  @id @default(uuid())
  projectId    String
  candidateId  String?
  documentId   String?
  sectionKey   String
  recordId     String?
  fieldKey     String
  documentName String
  page         Int?
  charOffset   Int?
  quote        String  @db.Text
  verified     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  candidate FieldCandidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  document  Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  record    SectionRecord?  @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([projectId, sectionKey, fieldKey])
  @@index([candidateId])
  @@map("evidence_items")
}

model FieldOverride {
  id             String              @id @default(uuid())
  projectId      String
  sectionKey     String
  fieldPath      String
  recordId       String?
  fieldKey       String?
  previousValue  Json?
  newValue       Json?
  source         FieldOverrideSource
  reason         String?             @db.Text
  overriddenById String

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sectionKey])
  @@map("field_overrides")
}

model SectionState {
  id                String               @id @default(uuid())
  projectId         String
  sectionKey        String
  status            SectionLifecycleStatus @default(NOT_STARTED)
  confirmedById     String?
  confirmedAt       DateTime?
  upstreamChangedAt DateTime?
  lastRunId         String?
  reviewState       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sectionKey])
  @@map("section_states")
}

model SectionRecord {
  id                      String       @id @default(uuid())
  projectId               String
  sectionKey              String
  groupPath               String
  parentRecordId          String?
  sortOrder               Int          @default(0)
  origin                  RecordOrigin @default(AI)
  tag                     CandidateTag?
  sourceContractRecordIds Json?

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent         SectionRecord?   @relation("RecordTree", fields: [parentRecordId], references: [id], onDelete: Cascade)
  children       SectionRecord[]  @relation("RecordTree")
  fieldValues    FieldValue[]
  evidenceItems  EvidenceItem[]

  @@index([projectId, sectionKey, groupPath])
  @@index([parentRecordId])
  @@map("section_records")
}

model FieldValue {
  id           String               @id @default(uuid())
  recordId     String
  fieldKey     String
  value        Json?
  status       FieldValueStatus     @default(NOT_FOUND)
  confidence   FieldConfidenceLevel @default(PROVISIONAL)
  review       FieldReviewState     @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  record     SectionRecord    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  candidates FieldCandidate[]

  @@unique([recordId, fieldKey])
  @@map("field_values")
}

model FieldCandidate {
  id           String           @id @default(uuid())
  fieldValueId String
  runStepId    String?
  value        Json?
  confidence   FieldConfidenceLevel @default(PROVISIONAL)
  tag          CandidateTag     @default(NEW)
  state        CandidateState   @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fieldValue FieldValue      @relation(fields: [fieldValueId], references: [id], onDelete: Cascade)
  runStep    ExtractionStep? @relation(fields: [runStepId], references: [id], onDelete: SetNull)
  evidence   EvidenceItem[]

  @@index([fieldValueId, state])
  @@map("field_candidates")
}

model ProjectSectionFilter {
  id          String  @id @default(uuid())
  projectId   String
  sectionKey  String
  version     Int     @default(1)
  content     String? @db.Text
  storageKey  String?
  fileName    String?
  mimeType    String?
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sectionKey, version])
  @@index([projectId, sectionKey])
  @@map("project_section_filters")
}

// ---------------------------------------------------------------------------
// Parameter Registry (Level 1/2 definitions; Level 3 is project-custom params in field store)
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Parameter Registry (Level 1/2 definitions; Level 3 is project-custom in field store)
// ---------------------------------------------------------------------------

model Species {
  id            String @id @default(uuid())
  botanicalName String @unique
  commonName    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parameters ParameterDefinition[]
  projects   Project[]

  @@map("species")
}

model ParameterDefinition {
  id               String             @id @default(uuid())
  speciesId        String? // null = UNIVERSAL (all species)
  name             String
  family           ParameterFamily
  level            ParameterLevel
  inputType        ParameterInputType
  scaleMin         Float?
  scaleMax         Float?
  scalePolarity    ScalePolarity?
  unit             String?
  howToMeasure     String?            @db.Text
  frequencyType    FrequencyType?
  threshold        String?
  thresholdType    String?
  eliminatoryLevel EliminatoryLevel?
  optionValues     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  species Species? @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@index([speciesId, family])
  @@index([level, family])
  @@map("parameter_definitions")
}

// ---------------------------------------------------------------------------
// Field Observer assignment (project activation — Step 8)
// ---------------------------------------------------------------------------

model FieldObserverAssignment {
  id                String    @id @default(uuid())
  projectId         String
  userId            String
  genotypeRecordId  String
  farmId            String
  plotId            String?
  protocolRecordId  String?
  assignedById      String
  assignedAt        DateTime  @default(now())
  activeFrom        DateTime  @default(now())
  activeTo          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  farm    Farm    @relation(fields: [farmId], references: [id], onDelete: Cascade)
  plot    Plot?   @relation(fields: [plotId], references: [id], onDelete: SetNull)

  @@index([projectId, userId])
  @@index([genotypeRecordId, farmId])
  @@map("field_observer_assignments")
}
