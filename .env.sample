PORT =
DATABASE_URL =
DB_NAME =

# Clerk Authentication
CLERK_PUBLISHABLE_KEY =
CLERK_SECRET_KEY =

# Clerk Webhook signing secret (from Clerk Dashboard → Webhooks → your endpoint)
CLERK_WEBHOOK_SECRET =

# Optional: Clerk user ID of the admin account (used by seedAdmin.js)
ADMIN_CLERK_USER_ID =

# Resend
RESEND_API_KEY =
RESEND_FROM_EMAIL =
NUBRED_LOGO_URL =

# ── Project / AI module ──────────────────────────────────────────────────────
# LLM provider: 'gemini' (default) or 'mock' (no API key required, for dev/test)
NUBRED_LLM_PROVIDER =

# Google AI Studio API key — required when NUBRED_LLM_PROVIDER=gemini
# WARNING: free tier may use content to improve Google models.
# Do NOT send real client contracts through the free tier.
# Use NUBRED_LLM_PROVIDER=mock during development until a paid key is provisioned.
GEMINI_API_KEY =

# Model to use (default: gemini-3.5-flash-lite for free-tier demos).
# Paid / higher quality: gemini-3.6-flash. gemini-2.0-flash is retired.
GEMINI_MODEL = gemini-3.5-flash-lite

# Requests-per-minute cap for the Gemini rate-limit token bucket.
# gemini-3.5-flash-lite free tier: 15 RPM — default 12 leaves headroom.
# gemini-3.6-flash free tier is only 5 RPM / 20 RPD — do not use it for demos.
# Paid tier: set higher (e.g. 60) and raise NUBRED_JOB_CONCURRENCY.
GEMINI_RPM_LIMIT = 12

# ── Document storage (S3-compatible) ──────────────────────────────────────────
# Works with MinIO (dev), Hetzner Object Storage, AWS S3, Cloudflare R2.
# Switch provider by changing endpoint + credentials — no code change.
# Object key: tenants/{tenantId}/projects/{projectId}/documents/{documentId}/{filename}
# Do NOT use Cloudinary for confidential contracts.
NUBRED_STORAGE_PROVIDER = s3
NUBRED_MAX_UPLOAD_BYTES = 52428800
NUBRED_PRESIGN_EXPIRES_SECONDS = 900
NUBRED_DEFAULT_TENANT_SLUG = dev
# Comma-separated browser origins allowed to PUT/GET objects (MinIO CORS).
NUBRED_STORAGE_CORS_ORIGINS = http://localhost:5173,http://localhost:3000

# ── Job queue worker (Postgres FOR UPDATE SKIP LOCKED) ────────────────────────
# Only the primary PM2 instance (NODE_APP_INSTANCE=0) or `npm run dev` runs this.
# API processes enqueue; they do not execute EXTRACT_TEXT / LLM jobs.
NUBRED_JOB_POLL_MS = 1000
# After contract finishes, genotype/phase/protocol run in parallel (3 jobs).
# Lite is 15 RPM so 3 follow-ups fit. Set 1 if large contracts hit the 250K TPM cap.
NUBRED_JOB_CONCURRENCY = 3
# Reclaim RUNNING jobs whose worker died (seconds).
NUBRED_JOB_LOCK_TIMEOUT_SECONDS = 600

# Max characters of document text sent to the LLM per section (default 350000).
NUBRED_EXTRACTION_MAX_CHARS = 350000

AWS_REGION = us-east-1
AWS_S3_BUCKET = nubred-dev-documents
AWS_ACCESS_KEY_ID = minioadmin
AWS_SECRET_ACCESS_KEY = minioadmin
# MinIO local: http://localhost:9000
# Hetzner OS:  https://fsn1.your-objectstorage.com  (example — use your region host)
# AWS S3:      leave empty
AWS_S3_ENDPOINT = http://localhost:9000
# Optional. Set when the SDK talks to an internal host (e.g. http://minio:9000)
# but the browser must PUT to a public host (e.g. http://localhost:9000).
AWS_S3_PUBLIC_ENDPOINT =
# Default: true when AWS_S3_ENDPOINT is set. Set false for native AWS S3.
AWS_S3_FORCE_PATH_STYLE = true
